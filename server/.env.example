# LifeOS server — copy to .env and fill in. NEVER commit the real .env (see spec §21).

# --- Database (canonical Postgres) ---
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql+psycopg://lifeos:lifeos@localhost:5432/lifeos

# --- Phase 1 has no external integrations. The keys below are placeholders for
#     later phases and are intentionally NOT read anywhere yet. Do not hardcode
#     the values these represent in code (spec §1 rule 1, §24) — read them here.
# ANTHROPIC_API_KEY=            # food agent (phase 3)
# ANTHROPIC_FOOD_MODEL=         # resolve current model string from Anthropic docs at build time
# SIMPLEFIN_TOKEN=              # finance (phase 4)
# ACTUAL_SERVER_URL=
# ACTUAL_PASSWORD=
